<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agsickle.recorder</string>
    <key>Comment</key>
    <string>A股镰刀手 盘中分钟快照录制器（C-ARC-3）：每5分钟一轮，非交易时段/节假日秒退（minute_snapshot 供盘中时点回放/回测）</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/xuwenhao/Desktop/A股镰刀手/deploy/run_recorder.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/xuwenhao/Desktop/A股镰刀手/logs/launchd/recorder.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xuwenhao/Desktop/A股镰刀手/logs/launchd/recorder.log</string>
</dict>
</plist>
