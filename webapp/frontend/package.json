{
  "name": "agsickle-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A股镰刀手 · AI交易员看板（Vite + React + TS 前端，构建产物输出到 webapp/dist）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
